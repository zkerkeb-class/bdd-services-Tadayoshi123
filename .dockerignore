# bdd-services-Tadayoshi123/.dockerignore
# Fichiers à exclure lors de la construction Docker

# ===================================
# 📂 DOSSIERS DE DÉVELOPPEMENT
# ===================================
node_modules/
.git/
.github/
coverage/
.nyc_output/
logs/
temp/
tmp/

# ===================================
# 📄 FICHIERS DE CONFIGURATION
# ===================================
.env
.env.*
!.env.example
.gitignore
.eslintrc*
.prettierrc*
jest.config.js
nodemon.json

# ===================================
# 📋 DOCUMENTATION ET TESTS
# ===================================
README.md
TEST_GUIDE.md
CHANGELOG.md
*.md
tests/
__tests__/
*.test.js
*.spec.js

# ===================================
# 🔧 OUTILS DE DÉVELOPPEMENT
# ===================================
.vscode/
.idea/
*.swp
*.swo
*~

# ===================================
# 📊 FICHIERS DE BUILD ET CACHE
# ===================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.cache/
dist/
build/

# ===================================
# 🐳 FICHIERS DOCKER
# ===================================
Dockerfile*
docker-compose*.yml
.dockerignore

# ===================================
# 🗄️ FICHIERS DE BASE DE DONNÉES
# ===================================
*.sqlite
*.db
*.sql
!prisma/migrations/
!prisma/schema.prisma

# ===================================
# 🔐 FICHIERS SENSIBLES
# ===================================
*.pem
*.key
*.crt
secrets/
.secrets/

# ===================================
# 📦 FICHIERS OS
# ===================================
.DS_Store
Thumbs.db
desktop.ini 