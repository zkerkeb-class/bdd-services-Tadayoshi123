{
  "name": "supervia-db-service",
  "version": "1.0.0",
  "description": "Microservice de gestion centralisée de la base de données PostgreSQL pour SupervIA",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "npx prisma migrate deploy && nodemon src/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:api": "node scripts/test-api.js",
    "test:api:verbose": "DEBUG=* node scripts/test-api.js",
    "swagger:gen": "node scripts/generate-swagger.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:reset": "prisma migrate reset",
    "prisma:studio": "prisma studio",
    "validate-config": "node src/scripts/validate-config.js",
    "setup": "npm install && npm run prisma:generate && npm run swagger:gen",
    "quick-start": "chmod +x scripts/quick-start.sh && ./scripts/quick-start.sh",
    "health": "curl -f http://localhost:3002/health || exit 1",
    "docker:build": "docker build -t supervia-db-service .",
    "docker:run": "docker run -p 3002:3002 --env-file .env supervia-db-service",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "db:delete-keys": "node scripts/delete-keys.js",
    "generate-swagger": "node scripts/generate-swagger.js"
  },
  "keywords": [
    "supervia",
    "microservice",
    "database",
    "postgresql",
    "prisma",
    "rest-api"
  ],
  "author": "SupervIA Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "axios": "^1.6.2",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-prom-bundle": "^8.0.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jose": "^6.0.11",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "prisma": "^5.7.1",
    "prom-client": "^15.1.0",
    "redis": "^4.6.10",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zkerkeb-class/bdd-services-Tadayoshi123"
  }
}
