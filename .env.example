# ==============================================================================
# 🗄️ SERVICE DE BASE DE DONNÉES SUPERVIA - CONFIGURATION D'EXEMPLE
# ==============================================================================
# Ce fichier sert de modèle pour votre propre fichier .env.
# Copiez ce fichier en .env et remplacez les valeurs ci-dessous.
# NE JAMAIS COMMITER VOTRE FICHIER .env DANS LE DÉPÔT GIT.

# ==============================================
# 📡 CONFIGURATION SERVEUR
# ==============================================
# Environnement d'exécution : 'development', 'production', ou 'test'
NODE_ENV=development

# Port sur lequel le service écoutera
PORT=3002

# Version de l'API (utilisé pour information)
API_VERSION=v1

# ==============================================
# 🗄️ BASE DE DONNÉES POSTGRESQL
# ==============================================
# URL de connexion à PostgreSQL.
# -> Pour le développement avec Docker, l'hôte doit être le nom du service (ex: 'postgres').
# -> Pour le développement local, l'hôte doit être 'localhost'.
# Assurez-vous que le nom de la base de données (ici 'supervia') est correct.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supervia?schema=public

# ==============================================
# 🔑 SÉCURITÉ ET AUTHENTIFICATION INTER-SERVICES
# ==============================================
# Secret pour signer et vérifier les JWT des autres services.
# DOIT être identique dans tous les microservices qui communiquent entre eux.
# Utilisez une chaîne de caractères longue, complexe et aléatoire.
JWT_SECRET=your_super_strong_and_long_secret_key_shared_across_services

# Liste des services autorisés à communiquer avec ce service (séparés par des virgules).
# Le 'serviceId' est extrait du payload du JWT entrant.
ALLOWED_SERVICES=auth-service,metrics-service,ai-service,payment-service,notification-service

# ==============================================
# 🌐 URLS & CORS
# ==============================================
# L'URL de base du service, utilisée pour la documentation Swagger.
API_URL=http://localhost:3002

# URLs autorisées pour les requêtes CORS (séparées par des virgules).
# Doit inclure l'URL de votre frontend gateway.
CORS_ORIGINS=http://localhost:3000

# ==============================================
# 🔧 CONFIGURATION DÉVELOPPEMENT & DEBUG
# ==============================================
# Activer ('true') ou désactiver la documentation Swagger sur /api-docs
ENABLE_SWAGGER=true

# Activer ('true') ou désactiver le logging des requêtes HTTP (morgan)
ENABLE_REQUEST_LOGGING=true

# ==============================================
# ⚙️ CONFIGURATION PRODUCTION (OPTIONNEL)
# ==============================================
# Paramètres pour la limitation du nombre de requêtes (rate limiting).
# Fenêtre de temps en millisecondes.
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes

# Nombre maximum de requêtes autorisées par fenêtre de temps, par IP.
RATE_LIMIT_MAX_REQUESTS=1000

# ==============================================
# 🎯 PROCHAINES ÉTAPES:
# ==============================================
# 1. Modifier DATABASE_URL avec vos paramètres PostgreSQL
# 2. Configurer JWT_SECRET (même que auth-service)
# 3. Ajuster CORS_ORIGINS selon vos services
# 4. Lancer: npm run setup 